<!-- Custom Video Player UI (Plyr) -->
<link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
<script defer src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>

<style>
  /* Override Plyr to match NMOS Blue */
  :root {
    --plyr-color-main: #3577F9;
    --plyr-video-background: transparent;
  }
  .plyr {
    border-radius: 4px;
  }
</style>

<script defer>
  document.addEventListener('DOMContentLoaded', () => {
    // Initializes the custom player on all videos with the "js-plyr" class
    const players = Array.from(document.querySelectorAll('.js-plyr')).map(p => new Plyr(p, {
        controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen']
    }));
  });
</script>

<!-- Inline Click-to-Copy Script -->
<script defer>
  document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.copy-text').forEach(el => {
          // Save the original text to copy (before we inject the icon)
          const textToCopy = el.innerText.trim();
          let copiedTimeout;

          // Wrap the original text and inject the copy icon
          el.innerHTML = `<span>${el.innerHTML}</span><i data-lucide="copy"></i>`;
          el.setAttribute('role', 'button');
          el.setAttribute('tabindex', '0');

          const copyText = () => {
              clearTimeout(copiedTimeout);
              el.classList.remove('copied', 'copy-failed');

              if (!navigator.clipboard) {
                  el.classList.add('copy-failed');
                  copiedTimeout = setTimeout(() => el.classList.remove('copy-failed'), 2000);
                  return;
              }

              navigator.clipboard.writeText(textToCopy).then(() => {
                  el.classList.add('copied');
                  copiedTimeout = setTimeout(() => el.classList.remove('copied'), 2000);
              }).catch(() => {
                  el.classList.add('copy-failed');
                  copiedTimeout = setTimeout(() => el.classList.remove('copy-failed'), 2000);
              });
          };

          // Handle mouse and keyboard activation.
          el.addEventListener('click', (e) => {
              e.preventDefault();
              copyText();
          });
          el.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  copyText();
              }
          });
      });
      
      // Initialize Lucide icons for the newly added icons
      if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

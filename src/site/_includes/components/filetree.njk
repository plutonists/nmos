{% macro menuItem(fileOrFolderName, fileOrFolder, step, currentPath) %}
    {%if fileOrFolder.isNote or fileOrFolder.isFolder%}
        <div x-show="isOpen" style="display:none" class="{{'filelist' if step>0}}">
            {%if fileOrFolder.isNote and not fileOrFolder.hide %}
                <div @click.stop class="notelink {{ 'active-note' if fileOrFolder.permalink === permalink}}">
                   <a {% if not fileOrFolder.icon %}data-note-icon="{{fileOrFolder.noteIcon}}"{% endif %} style="text-decoration: none;" class="filename" href="{{fileOrFolder.permalink}}">
    {% if fileOrFolder.icon %}
        {% if "lucide-" in fileOrFolder.icon %}
            <i data-lucide="{{ fileOrFolder.icon | replace('lucide-', '') }}" style="width: 16px; height: 16px; margin-right: 4px; display: inline-block; vertical-align: -3px; color: var(--text-accent);"></i>
        {% elif ".svg" in fileOrFolder.icon %}
            {% set iconUrl = fileOrFolder.icon | replace("[[", "") | replace("]]", "") %}
            {% if not iconUrl.startsWith("/") and not iconUrl.startsWith("http") %}
                {% set iconUrl = "/img/user/" + iconUrl %}
            {% endif %}
            <span class="nmos-svg-icon" style="-webkit-mask-image: url('{{ iconUrl }}'); mask-image: url('{{ iconUrl }}');"></span>
        {% elif ".png" in fileOrFolder.icon or ".jpg" in fileOrFolder.icon or ".gif" in fileOrFolder.icon or ".webp" in fileOrFolder.icon %}
            {% set iconUrl = fileOrFolder.icon | replace("[[", "") | replace("]]", "") %}
            {% if not iconUrl.startsWith("/") and not iconUrl.startsWith("http") %}
                {% set iconUrl = "/img/user/" + iconUrl %}
            {% endif %}
            <img src="{{ iconUrl }}" style="width: 16px; height: 16px; margin-right: 4px; display: inline-block; vertical-align: -3px; object-fit: contain;">
        {% else %}
            <span style="margin-right: 4px; display: inline-block; vertical-align: middle;">{{ fileOrFolder.icon }}</span>
        {% endif %}
    {% endif %}
    {{fileOrFolder.name | striptags | safe }}
    {% if fileOrFolder.isProtected %}<i data-lucide="lock" style="width: 14px; height: 14px; margin-left: 4px; display: inline-block; vertical-align: -2px; color: var(--text-accent);"></i>{% endif %}
</a>
                </div>
            {% elif fileOrFolder.isFolder%}
                            <div class="folder inner-folder level-{{step}}" data-folder-name="{{ fileOrFolderName | lower }}" x-data="{isOpen: false}" @click.stop="isOpen=!isOpen">
                        <div class="foldername-wrapper align-icon">
                    <i x-show="isOpen" style="display: none;"  data-lucide="chevron-down"></i>
                    <i x-show="!isOpen"  data-lucide="chevron-right"></i>
                    <span class="foldername">{{fileOrFolderName}}</span>
                    </div>
                    {% for fileOrFolderName, child in fileOrFolder %}
                        {{menuItem(fileOrFolderName, child, step+1, (currentPath+"/"+fileOrFolderName))}}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {%endif%}
{% endmacro %}

<div x-init="isDesktop = (window.innerWidth>=1000) ? true: false;"
        x-on:resize.window="isDesktop = (window.innerWidth>=1000) ? true : false;"
        x-data="{isDesktop: true, showFilesMobile: false}">

        <div x-show.important="!isDesktop" style="display: none;" :style="showFilesMobile ? 'opacity: 0; pointer-events: none; transition: opacity 0.2s ease;' : 'opacity: 1; transition: opacity 0.2s ease;'">
        {%include "components/filetreeNavbar.njk"%}
    </div>
    
    <div x-show="showFilesMobile && !isDesktop" @click="showFilesMobile = false" style="display:none;" class="fullpage-overlay"></div>

<div class="filetree-wrapper" x-show.important="isDesktop || showFilesMobile" style="display: none;">
    <nav class="filetree-sidebar">
{% for imp in dynamics.filetree.beforeTitle %}
                {% include imp %}
            {% endfor %}

            <!-- Sync animation across page loads using global time so it never resets -->
            <script>
                document.write(`<style>.nmos-svg-glimmer-rect { animation-delay: -${(Date.now() % 10000) / 1000}s !important; }</style>`);
            </script>

            <!-- NMOS SVG Logo with Masked Striped Shine -->
            <a href="/" class="nmos-logo-link">
                <div class="logo-shine-wrapper">
                    <svg class="nmos-svg-logo" width="100%" height="100%" viewBox="0 0 1000 1000" version="1.1" xmlns="http://www.w3.org/2000/svg">
                        
                        <!-- 1. The base, static colored logo -->
                        <g>
                            <path d="M-0,472.241l0,-472.241l382.031,0l0,472.241l-178.109,0l0,-380.491l-26.458,0l0,380.491l-177.464,0Z" fill="#ff3366"/>
                            <path d="M411.7,472.241l0,-472.241l588.3,0l0,472.241l-178.626,0l0,-380.491l-26.535,0l0,380.491l-178.626,0l0,-380.491l-26.535,0l0,380.491l-177.978,0Z" fill="#2979ff"/>
                            <path d="M0,1000l0,-472.241l382.031,0l0,472.241l-382.031,0Zm177.464,-91.75l26.458,0l0,-288.741l-26.458,0l0,288.741Z" fill="#00c853"/>
                            <path d="M411.7,1000l0,-157.863l274.275,0l0,55.994l40.744,0l0,-82.979l-315.019,0l0,-287.392l588.3,0l0,157.863l-273.281,0l0,-66.114l-40.744,0l0,93.773l314.025,0l0,286.717l-588.3,0Z" fill="#ffc107"/>
                        </g>

                        <!-- 2. Define masks and gradients -->
                        <defs>
                            <!-- The Mask (Letters) -->
                            <clipPath id="nmos-letter-mask">
                                <path d="M-0,472.241l0,-472.241l382.031,0l0,472.241l-178.109,0l0,-380.491l-26.458,0l0,380.491l-177.464,0Z" />
                                <path d="M411.7,472.241l0,-472.241l588.3,0l0,472.241l-178.626,0l0,-380.491l-26.535,0l0,380.491l-178.626,0l0,-380.491l-26.535,0l0,380.491l-177.978,0Z" />
                                <path d="M0,1000l0,-472.241l382.031,0l0,472.241l-382.031,0Zm177.464,-91.75l26.458,0l0,-288.741l-26.458,0l0,288.741Z" />
                                <path d="M411.7,1000l0,-157.863l274.275,0l0,55.994l40.744,0l0,-82.979l-315.019,0l0,-287.392l588.3,0l0,157.863l-273.281,0l0,-66.114l-40.744,0l0,93.773l314.025,0l0,286.717l-588.3,0Z" />
                            </clipPath>

                            <!-- The Striped Gradient -->
                            <linearGradient id="nmos-glimmer-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
                                <stop offset="10%" stop-color="#ff3366" />
                                <stop offset="30%" stop-color="#ff3366" />
                                <stop offset="30%" stop-color="#2979ff" />
                                <stop offset="50%" stop-color="#2979ff" />
                                <stop offset="50%" stop-color="#00c853" />
                                <stop offset="70%" stop-color="#00c853" />
                                <stop offset="70%" stop-color="#ffc107" />
                                <stop offset="90%" stop-color="#ffc107" />
                                <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                            </linearGradient>
                        </defs>

                        <!-- 3. Render the gradient block, masked to the letters -->
                        <g clip-path="url(#nmos-letter-mask)">
                            <rect class="nmos-svg-glimmer-rect" x="0" y="-500" width="1500" height="2000" fill="url(#nmos-glimmer-grad)" />
                        </g>
                    </svg>
                </div>
                <span class="nmos-logo-text">
                    <span class="nmos-text-red">Notes,</span> <span class="nmos-text-blue">Media,</span><br>
                    <span class="nmos-text-green">&amp; Other</span> <span class="nmos-text-yellow">Stuff</span>
                </span>
            </a>

            {% for imp in dynamics.filetree.afterTitle %}
                {% include imp %}
            {% endfor %}
            {% if settings.dgEnableSearch === true%}
                {% include "components/searchButton.njk" %}
            {%endif%}
<div class="folder" x-data="{isOpen: true}">
    <!-- 1. Render Notes First (Wrapped to retain spacing) -->
    <div class="root-notes-wrapper" style="margin-bottom: 1.5rem;">
        {%- for fileOrFolderName, fileOrFolder in filetree -%}
            {% if fileOrFolder.isNote %}
                {{menuItem(fileOrFolderName, fileOrFolder, 0, fileOrFolderName)}}
            {% endif %}
        {%- endfor -%}
    </div>

    <!-- 2. Render Folders Second -->
    {%- for fileOrFolderName, fileOrFolder in filetree -%}
        {% if fileOrFolder.isFolder %}
            {{menuItem(fileOrFolderName, fileOrFolder, 0, fileOrFolderName)}}
        {% endif %}
    {%- endfor -%}
</div>
        </nav>
    </div>
</div>

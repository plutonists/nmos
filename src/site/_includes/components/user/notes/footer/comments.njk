{% if not password %}
    <div style="margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--background-modifier-border);">
        <h2 style="margin-top: 0; margin-bottom: 20px; border: none; padding-bottom: 0;">Comments</h2>
        
        <div style="width: 100%; max-width: 100%; overflow: hidden; display: block; position: relative;">
            <script>
              window.CUSDIS_LOCALE = {
                "en": {
                  "post": "Post Comment",
                  "reply": "Reply",
                  "cancel": "Cancel",
                  "reply_to": "Reply to",
                  "placeholder": "Write your thoughts here...",
                  "name": "Name",
                  "email": "Email (optional)",
                  "website": "Website (optional)"
                }
              };
            </script>
            
            <!-- Point data-theme to your compiled CSS file! -->
            <div id="cusdis_thread" class="nmos-cusdis-wrapper"
              data-host="https://cusdis.com"
              data-app-id="425fa494-1e5f-4392-b7ef-0d09394e9e18"
              data-page-id="{{ page.url }}"
              data-page-url="{{ meta.siteBaseUrl }}{{ page.url }}"
              data-page-title="{{ title | default(page.fileSlug) }}"
              data-theme="{{ meta.siteBaseUrl }}/styles/custom-style.css">
            </div>
        </div>
        
        <!-- Script with hardcoded inline overrides to clip the iframe bounding box -->
        <script async defer src="https://cusdis.com/js/cusdis.es.js" onload="
            setTimeout(() => {
                const iframe = document.querySelector('#cusdis_thread iframe');
                if(iframe) {
                    iframe.setAttribute('style', 'width: 100% !important; max-width: 100% !important; border: none !important; display: block !important; overflow: hidden !important; min-height: 250px !important;');
                    iframe.scrolling = 'no';
                }
            }, 500);
        "></script>
        
    </div>
{% endif %}

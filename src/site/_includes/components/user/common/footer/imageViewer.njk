<!-- Custom NMOS Image Viewer -->
<div id="nmos-image-viewer" class="nmos-image-viewer" style="display: none;">
    <div class="nmos-iv-overlay" id="nmos-iv-overlay" title="Click to close"></div>
    
    <!-- Image Counter -->
    <div id="nmos-iv-counter" class="nmos-iv-counter"></div>

    <div class="nmos-iv-toolbar">
        <button id="nmos-iv-copy" title="Copy Link"><i data-lucide="link"></i></button>
        <button id="nmos-iv-download" title="Save Image"><i data-lucide="download"></i></button>
        <button id="nmos-iv-zoom" title="Fit to Screen"><i data-lucide="zoom-in"></i></button>
        <button id="nmos-iv-close" title="Close"><i data-lucide="x"></i></button>
    </div>

    <!-- Navigation Arrows -->
    <button id="nmos-iv-prev" class="nmos-iv-nav nmos-iv-nav-left" title="Previous Image"><i data-lucide="chevron-left"></i></button>
    <button id="nmos-iv-next" class="nmos-iv-nav nmos-iv-nav-right" title="Next Image"><i data-lucide="chevron-right"></i></button>

    <div class="nmos-iv-content" id="nmos-iv-content" title="Click outside image to close">
        <img id="nmos-iv-img" src="" alt="Expanded Image" />
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const viewer = document.getElementById('nmos-image-viewer');
    const overlay = document.getElementById('nmos-iv-overlay');
    const contentBox = document.getElementById('nmos-iv-content');
    const img = document.getElementById('nmos-iv-img');
    
    const btnClose = document.getElementById('nmos-iv-close');
    const btnCopy = document.getElementById('nmos-iv-copy');
    const btnDownload = document.getElementById('nmos-iv-download');
    const btnZoom = document.getElementById('nmos-iv-zoom');
    
    const btnPrev = document.getElementById('nmos-iv-prev');
    const btnNext = document.getElementById('nmos-iv-next');
    const counterEl = document.getElementById('nmos-iv-counter');

    let currentSrc = '';
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    
    // Gallery Navigation State
    let pageImages = [];
    let currentImageIndex = -1;

    function updateTransform(animate = false) {
        img.style.transition = animate ? 'transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1)' : 'none';
        img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
        
        if (scale > 1) {
            img.style.cursor = 'grab';
            btnZoom.innerHTML = '<i data-lucide="zoom-out"></i>';
        } else {
            img.style.cursor = 'zoom-in';
            btnZoom.innerHTML = '<i data-lucide="zoom-in"></i>';
        }
        if (typeof lucide !== 'undefined') lucide.createIcons({ root: btnZoom });
    }

    function resetViewer() {
        scale = 1;
        translateX = 0;
        translateY = 0;
        updateTransform(true);
    }

    function updateNavUI() {
        // Disable buttons at the edges
        btnPrev.disabled = currentImageIndex <= 0;
        btnNext.disabled = currentImageIndex >= pageImages.length - 1;
        
        // Update Counter
        if (pageImages.length > 0) {
            counterEl.style.display = 'block';
            counterEl.textContent = `${currentImageIndex + 1} / ${pageImages.length}`;
        } else {
            counterEl.style.display = 'none';
        }
    }

    function navigateGallery(dir) {
        if (currentImageIndex === -1 || pageImages.length === 0) return;
        const newIndex = currentImageIndex + dir;
        
        if (newIndex >= 0 && newIndex < pageImages.length) {
            currentImageIndex = newIndex;
            const newImg = pageImages[currentImageIndex];
            currentSrc = newImg.currentSrc || newImg.src;
            img.src = currentSrc;
            
            resetViewer();
            updateNavUI();
        }
    }

    // 1. Open Viewer via Event Delegation
    document.addEventListener('click', (e) => {
        const imgTarget = e.target.closest('main.content img:not(.site-logo)');
        if (imgTarget) {
            e.preventDefault();
            
            // Re-fetch images to ensure correct count
            pageImages = Array.from(document.querySelectorAll('main.content img:not(.site-logo)'));
            currentImageIndex = pageImages.indexOf(imgTarget);
            
            currentSrc = imgTarget.currentSrc || imgTarget.src;
            img.src = currentSrc;
            
            updateNavUI();
            
            viewer.style.display = 'flex';
            document.body.style.overflow = 'hidden'; 
            resetViewer();
        }
    });

    // 2. Navigation Button Clicks
    btnPrev.addEventListener('click', (e) => { e.stopPropagation(); navigateGallery(-1); });
    btnNext.addEventListener('click', (e) => { e.stopPropagation(); navigateGallery(1); });

    // 3. Close Viewer Logic
    function closeViewer() {
        viewer.classList.add('nmos-iv-closing');
        document.body.style.overflow = ''; 
        setTimeout(() => {
            viewer.style.display = 'none';
            viewer.classList.remove('nmos-iv-closing'); 
        }, 200); 
    }
    
    btnClose.addEventListener('click', closeViewer);
    overlay.addEventListener('click', closeViewer);
    contentBox.addEventListener('click', (e) => {
        if (e.target === contentBox) closeViewer();
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => { 
        if (viewer.style.display === 'flex' && !viewer.classList.contains('nmos-iv-closing')) {
            if (e.key === 'Escape') closeViewer();
            if (e.key === 'ArrowLeft') navigateGallery(-1);
            if (e.key === 'ArrowRight') navigateGallery(1);
        }
    });

    // 4. Copy & Download 
    btnCopy.addEventListener('click', () => {
        const absoluteUrl = new URL(currentSrc, window.location.origin).href;
        navigator.clipboard.writeText(absoluteUrl).then(() => {
            btnCopy.innerHTML = '<i data-lucide="check"></i>';
            if (typeof lucide !== 'undefined') lucide.createIcons({ root: btnCopy });
            setTimeout(() => {
                btnCopy.innerHTML = '<i data-lucide="link"></i>';
                if (typeof lucide !== 'undefined') lucide.createIcons({ root: btnCopy });
            }, 2000);
        });
    });

    btnDownload.addEventListener('click', () => {
        const a = document.createElement('a');
        a.href = currentSrc;
        a.download = currentSrc.split('/').pop() || 'nmos-image';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    });

    // 5. Drag to Pan & Click to Toggle Zoom
    let isDragging = false;
    let hasMoved = false; 
    let startX, startY, startTx, startTy;

    img.addEventListener('mousedown', (e) => {
        e.preventDefault(); 
        isDragging = true;
        hasMoved = false;
        startX = e.clientX; startY = e.clientY;
        startTx = translateX; startTy = translateY;
        if (scale > 1) img.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX; const dy = e.clientY - startY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasMoved = true;
        if (hasMoved) {
            translateX = startTx + dx; translateY = startTy + dy;
            updateTransform(false); 
        }
    });

    window.addEventListener('mouseup', (e) => {
        if (!isDragging) return;
        isDragging = false;
        if (!hasMoved) {
            if (scale !== 1) resetViewer();
            else {
                const rect = contentBox.getBoundingClientRect();
                const mouseX = e.clientX - rect.left - rect.width / 2;
                const mouseY = e.clientY - rect.top - rect.height / 2;
                const targetScale = 2.5; 
                const ratio = 1 - (targetScale / scale);
                translateX += (mouseX - translateX) * ratio;
                translateY += (mouseY - translateY) * ratio;
                scale = targetScale;
                updateTransform(true);
            }
        } else {
            if (scale > 1) img.style.cursor = 'grab';
        }
    });

    // 6. Scrollwheel Zoom
    contentBox.addEventListener('wheel', (e) => {
        e.preventDefault(); 
        const rect = contentBox.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;
        const zoomSensitivity = 0.002;
        const delta = -e.deltaY * zoomSensitivity;
        let newScale = scale * Math.exp(delta);
        newScale = Math.max(0.5, Math.min(newScale, 15));
        const ratio = 1 - (newScale / scale);
        translateX += (mouseX - translateX) * ratio;
        translateY += (mouseY - translateY) * ratio;
        scale = newScale;
        updateTransform(false); 
    }, { passive: false });

    // Toolbar Zoom Button Toggle
    btnZoom.addEventListener('click', () => {
        if (scale !== 1) resetViewer();
        else {
            scale = 2;
            updateTransform(true);
        }
    });
});
</script>

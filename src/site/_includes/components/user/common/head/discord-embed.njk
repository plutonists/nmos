<!-- Discord & Social Media Embed Tags -->
<meta property="og:site_name" content="Notes, Media, & Other Stuff" />
<meta property="og:title" content="{{ title | default('Notes, Media, & Other Stuff') }}" />
<meta property="og:description" content="{{ description | default('A personal database of thoughts, notes, and everything in between.') }}" />

{% if image %}
    <!-- Custom image provided in Obsidian: Use LARGE BANNER layout -->
    <meta property="og:image" content="{{ image }}" />
    <meta name="twitter:image" content="{{ image }}" />
    <meta name="twitter:card" content="summary_large_image" />
{% else %}
    <!-- No custom image provided: Use SMALL SQUARE thumbnail layout -->
    <meta property="og:image" content="https://i.clouds.tf/78vt/37tf.png" />
    <meta name="twitter:image" content="https://i.clouds.tf/78vt/37tf.png" />
    <meta name="twitter:card" content="summary" />
{% endif %}

<meta name="theme-color" content="#2979FF" />

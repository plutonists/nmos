<!-- Discord & Social Media Embed Tags -->
<meta property="og:site_name" content="Notes, Media, & Other Stuff" />

<!-- Dynamic Title: Uses Obsidian 'title' property, then file name, then fallback -->
{% set embedTitle = title or noteTitle or "Notes, Media, & Other Stuff" %}
<meta property="og:title" content="{{ embedTitle | striptags }}" />

<!-- Dynamic Description: Uses Obsidian 'desc' property, then fallback -->
{% set embedDesc = desc or description or "A personal database of thoughts, notes, and everything in between." %}
<meta property="og:description" content="{{ embedDesc | striptags }}" />

{% if banner %}
    <!-- Custom image provided in Obsidian: Use LARGE BANNER layout -->
    <meta property="og:image" content="{{ banner }}" />
    <meta name="twitter:image" content="{{ banner }}" />
    <meta name="twitter:card" content="summary_large_image" />
{% else %}
    <!-- No custom image provided: Use SMALL SQUARE thumbnail layout -->
    <meta property="og:image" content="https://i.clouds.tf/78vt/37tf.png" />
    <meta name="twitter:image" content="https://i.clouds.tf/78vt/37tf.png" />
    <meta name="twitter:card" content="summary" />
{% endif %}

<meta name="theme-color" content="#2979FF" />
